# Copy to frontend/.env.local. Exported variables take precedence.
NEXT_PUBLIC_API_BASE_URL=http://localhost:9020
NEXT_PUBLIC_REFRESH_INTERVAL_SECONDS=30
NEXT_PUBLIC_DEFAULT_PAGE_SIZE=20
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=9520

# Optional server-only override for the same-origin proxy:
# AJO_API_ORIGIN=http://localhost:9020
# AJO_NEXT_DIST_DIR=.next

# Next.js development-server hosts (no scheme or port). Add your LAN hostname/IP.
AJO_ALLOWED_DEV_ORIGINS=localhost,127.0.0.1
